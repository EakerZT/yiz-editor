{
  "name": "@eakerzt/yiz-editor",
  "version": "0.0.1",
  "description": "Reusable Vue 3 editor infrastructure for canvas-based designers.",
  "keywords": [
    "vue",
    "editor",
    "canvas",
    "designer"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://eakerzt.github.io/yiz-editor/",
  "bugs": {
    "url": "https://github.com/EakerZT/yiz-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EakerZT/yiz-editor.git"
  },
  "license": "MIT",
  "author": "EakerZT",
  "main": "./dist/yiz-editor.cjs",
  "module": "./dist/yiz-editor.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/yiz-editor.mjs",
      "require": "./dist/yiz-editor.cjs"
    },
    "./dist/yiz-editor.css": "./dist/yiz-editor.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "site:build": "vite build --config vite.config.site.mts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"scripts/**/*.{ts,vue,less}\" \"site/**/*.{ts,vue,less}\" \"tests/**/*.ts\" \"plans/**/*.md\" \"*.{ts,mts,json,md}\"",
    "format:check": "prettier --check \"scripts/**/*.{ts,vue,less}\" \"site/**/*.{ts,vue,less}\" \"tests/**/*.ts\" \"plans/**/*.md\" \"*.{ts,mts,json,md}\"",
    "build": "vite build --config vite.config.lib.mts && vue-tsc --project tsconfig.build.json",
    "prepublishOnly": "yarn typecheck && yarn test && yarn build"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  },
  "volta": {
    "node": "25.9.0",
    "yarn": "1.22.22"
  },
  "devDependencies": {
    "@eakerzt/yiz-ui": "0.0.28",
    "@types/node": "^25.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "less": "^4.6.4",
    "prettier": "^3.8.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-router": "^4.5.1",
    "vue-tsc": "^3.3.9"
  }
}
